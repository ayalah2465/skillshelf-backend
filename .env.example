# Copy to .env locally. Never upload .env to GitHub.
NODE_ENV=development
PORT=3000
# Paste a PostgreSQL connection URL, including password; URL-encode special characters.
DATABASE_URL=
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Keep 0 locally. On Render, one trusted reverse proxy: set to 1.
TRUST_PROXY_HOPS=0
# Explicit seed only; never runs automatically on startup.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
